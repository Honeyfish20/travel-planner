# Copy to .env (git-ignored), fill in, then:  set -a; . ./.env; set +a
# Required: API key of an Anthropic-compatible Messages API
ADA_TOKEN=<your-api-key>
# Optional: gateway base URL (unset = Anthropic public API)
# ADA_BASE_URL=<your-gateway-base-url>
# ADA_MODEL=claude-sonnet-5

# Optional: web search providers
# EXA_API_KEY=<your-exa-key>
# BOCHA_API_KEY=<your-bocha-key>
# BOCHA_MCP_URL=<remote-bocha-mcp-url>

# Optional: offline / reproducible demo
# WEATHER=off
# WEB_SEARCH=off
